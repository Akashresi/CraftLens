# ==============================================================================
# CraftLens 2.0 Global Environment Configuration Template
# ==============================================================================

# Core Application Environment
APP_ENV=development
APP_NAME="CraftLens 2.0"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-64-character-hex-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days for dev/artisan ease; 60 mins in prod
REFRESH_TOKEN_EXPIRE_DAYS=30

# Network & Host Binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8081","exp://localhost:8081"]

# Database Configurations (PostgreSQL + pgvector)
# For local development with zero external daemon requirements:
DATABASE_URL="sqlite:///./craftlens_dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://craftlens_user:craftlens_secure_pass@localhost:5432/craftlens_db"
# ASYNC_DATABASE_URL="postgresql+asyncpg://craftlens_user:craftlens_secure_pass@localhost:5432/craftlens_db"

# Redis Cache & Asynchronous Broker
REDIS_URL="redis://localhost:6379/0"

# S3-Compatible Object Storage (MinIO / AWS S3 / Cloudflare R2)
STORAGE_PROVIDER="local"  # "local", "s3", or "minio"
LOCAL_UPLOAD_DIR="./uploads"
S3_ENDPOINT_URL=""
S3_BUCKET_NAME="craftlens-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="ap-south-1"

# AI & LLM Service Keys (Configurable Adapters)
GEMINI_API_KEY=""
LLM_PROVIDER="gemini" # "gemini", "openai", "local_ollama"
GEMINI_MODEL="gemini-2.5-flash"

# Indian Language Speech & Translation (Bhashini / IndicTrans2)
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""
BHASHINI_PIPELINE_ID=""
ASR_FALLBACK="whisper_local"

# Payment Gateway (Sandbox Mode)
PAYMENT_GATEWAY="razorpay_sandbox"
RAZORPAY_KEY_ID="rzp_test_sampleKey12345"
RAZORPAY_KEY_SECRET="sampleSecretForTesting12345"

# Observability & Monitoring
SENTRY_DSN=""
ENABLE_OPENTELEMETRY=false
LOG_LEVEL="INFO"
