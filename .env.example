# ==============================================================================
# CraftLens 2.0 Global Environment Configuration Template
# Copy to .env and replace all placeholder values before running in production.
# ==============================================================================

APP_ENV=development
APP_NAME="CraftLens 2.0"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-64-character-hex-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Network & Host Binding
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
AI_SERVICE_URL=http://127.0.0.1:8001
PUBLIC_WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001","http://localhost:8081","exp://localhost:8081"]

# Database Configurations (SQLite for local dev, PostgreSQL for compose/prod)
DATABASE_URL="sqlite:///./craftlens_dev.db"
POSTGRES_USER=craftlens_user
POSTGRES_PASSWORD=change_me_local_dev_password
POSTGRES_DB=craftlens_db

# Redis Cache & Job Queue
REDIS_URL="redis://localhost:6379/0"

# Storage & Malware Scanning
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="./uploads"
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_AUDIO_UPLOAD_BYTES=15728640
CLAMAV_HOST=""
CLAMAV_PORT=3310

# Ed25519 Provenance Signing Key (PEM with \n newlines; generated in dev if empty)
HERITAGE_ED25519_PRIVATE_KEY_PEM=""

# AI & LLM Service Keys
GEMINI_API_KEY=""
LLM_PROVIDER="gemini"
GEMINI_MODEL="gemini-2.5-flash"

# Indian Language Speech & Translation
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""
BHASHINI_PIPELINE_ID=""
ASR_FALLBACK="whisper_local"

# Payment Gateway (Sandbox Mode)
PAYMENT_GATEWAY="razorpay_sandbox"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# DPDP Act 2023 Grievance Officer Contact
DPDP_GRIEVANCE_OFFICER_NAME="CraftLens Data Protection & Grievance Officer"
DPDP_GRIEVANCE_OFFICER_EMAIL="grievance@craftlens.org"
DPDP_GRIEVANCE_OFFICER_PHONE="+91-11-2338-0000"

# Observability & Monitoring
SENTRY_DSN=""
LOG_LEVEL="INFO"
